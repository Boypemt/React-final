# ============================================================
# Disney Clue Guesser (กลุ่ม Sigma) — ตัวอย่างไฟล์ Environment
# ------------------------------------------------------------
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วใส่คีย์จริง
#   cp .env.local.example .env.local
#
# ทำไมไม่มี NEXT_PUBLIC_ นำหน้า?
#   ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ จะถูก Next.js ฝังลงไปใน
#   JavaScript Bundle ฝั่ง Client ทำให้ใครก็เปิดดูคีย์ได้จาก DevTools
#   ตัวแปรสองตัวนี้จึงถูกอ่านเฉพาะใน Route Handler ฝั่ง Server เท่านั้น
#   (ดู app/api/ai/clues/route.js และ lib/ai/gemini.js)
#
# .env.local ถูก .gitignore ไว้แล้ว (บรรทัด `.env*.local`) จึงไม่หลุดขึ้น Git
# ============================================================

# คีย์ Google Gemini API — ขอฟรีได้ที่ https://aistudio.google.com/apikey
# ปล่อยว่างไว้ได้ ระบบจะสลับไปใช้ Fallback Clues อัตโนมัติ (เล่นเกมได้ปกติ)
GEMINI_API_KEY=

# ------------------------------------------------------------
# กุญแจเข้ารหัสซองสถานะเกม (Sealed Game Token) — จำเป็นต้องมี ไม่งั้นเริ่มเกมไม่ได้
# ------------------------------------------------------------
# ใช้ทำอะไร: Server สุ่มตัวละครลับแล้วเก็บไว้ในซองที่เข้ารหัสด้วย AES-256-GCM
#   ก่อนส่งไปฝากไว้กับเบราว์เซอร์ (ดู lib/gameToken.js)
#   เบราว์เซอร์จึงถือสถานะเกมไว้ได้โดยอ่านคำตอบไม่ออกและแก้ค่าในซองไม่ได้
#
# ทำไมต้องเป็นความลับ: ใครได้กุญแจนี้ไปก็ถอดรหัสซองอ่านคำตอบได้ทันที
#   และปลอมซองของตัวเองได้ด้วย — ห้ามใส่ NEXT_PUBLIC_ นำหน้าเด็ดขาด
#
# วิธีสร้างค่า (ต้องได้ 32 ไบต์ขึ้นไป เข้ารหัสเป็น base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# หมายเหตุ: ถ้าเปลี่ยนค่านี้ ซองที่ออกไปก่อนหน้าจะใช้ต่อไม่ได้ทันที
#   ผู้เล่นที่ค้างอยู่กลางเกมจะเจอข้อความให้เริ่มเกมใหม่ (ไม่ใช่หน้าจอพัง)
GAME_SECRET=

# โมเดลที่ใช้สร้างคำใบ้ (flash-lite = เร็วสุด + โควตาฟรีสูง เหมาะกับเกมที่ยิงบ่อย)
#
# หมายเหตุสำคัญ: Proposal เขียนไว้ว่า gemini-2.5-flash แต่ปัจจุบัน Google
# ปิดรับคีย์ใหม่สำหรับรุ่นนั้นแล้ว (ตอบ 404 "no longer available to new users")
# จึงเปลี่ยนมาใช้ gemini-3.1-flash-lite ซึ่งทดสอบแล้วเร็วและเสถียรที่สุด
# ถ้าอยากเปลี่ยนรุ่น แก้ที่บรรทัดนี้ได้เลยโดยไม่ต้องแตะโค้ด
GEMINI_MODEL=gemini-3.1-flash-lite

# Base URL ของเว็บไซต์ สำหรับสร้าง Sitemap, Robots.txt และ Metadata Canonical URL
# ค่าเริ่มต้นหากไม่ระบุคือ https://disney-clue-guesser.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

